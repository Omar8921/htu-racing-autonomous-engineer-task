Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: __FIXED_FRAME__
    Frame Rate: 30

  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.25
      Cell Size: 1
      Color: 160; 160; 160
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Raw LiDAR
      Alpha: 0.30
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /velodyne_points

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Non-Ground Points
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/non_ground_points

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: ROI Points
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/roi_points

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Clustered Points
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/clustered_points

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.5
      Yaw: 0

Window Geometry:
  Height: 800
  Width: 1200
